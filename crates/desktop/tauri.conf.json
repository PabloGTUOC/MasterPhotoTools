{
  "productName": "MasterPhotoTools",
  "version": "0.1.0",
  "identifier": "com.phototools.master",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../frontend/desktop"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../frontend/desktop"
    },
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../frontend/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhotoTools",
        "width": 1180,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Photography",
    "shortDescription": "Ingest, prepare and publish photographs",
    "longDescription": "Ingest photographs from a camera SD card, validate and prepare them, publish them to Google Photos, and maintain a photo library on a NAS.",
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
