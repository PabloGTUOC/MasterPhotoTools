# PhotoTools environment variables
#
# Copy to .env and fill in. No values are committed to the repository.
# Secrets never enter the photo library and never enter git (spec §9.2 rule 4).

# ---------------------------------------------------------------------------
# Filesystem — read by phototools-core (config.rs)
# ---------------------------------------------------------------------------

# Colon-separated list of directories the system is allowed to touch.
# Every path supplied by an API or UI is canonicalised and rejected unless it
# resolves inside one of these (G6, spec §9.2 rule 2). Empty means nothing is
# reachable. Example: /mnt/photos:/mnt/scans
# ROOTS=

# Where the desktop writes derivatives for the server to pick up (spec §2.3).
# Default: /tmp/phototools-staging
# STAGING_DIR=

# SQLite ledger path. Must sit outside the photo library (spec §7).
# Default: /tmp/phototools.db
# DATABASE_PATH=

# ---------------------------------------------------------------------------
# Validation thresholds — read by phototools-core (config.rs), see F12
# ---------------------------------------------------------------------------
#
# A variable that is set but unparseable is a startup error, not a silent
# fallback to the default (spec §9.2 invariant 6).

# Reject a capture date further than this many days from now. Default: 90
# MAX_AGE_DAYS=

# Resolution ceiling for a published frame, in megapixels. Default: 10
# A modern 24-45 MP camera fails this on virtually every frame, so resizing is
# the normal path, not the exception (spec F12).
# MAX_MEGAPIXELS=

# Byte ceiling for a published file. Default: 10485760 (10 MB)
# Independent of MAX_MEGAPIXELS; both apply to the JPEG and RAW-derived paths.
# MAX_OUTPUT_BYTES=

# ---------------------------------------------------------------------------
# Server — read by phototools-server
# ---------------------------------------------------------------------------

# TCP port for the axum server. Default: 3000
# PORT=

# Tracing filter. Default: phototools_server=debug,tower_http=debug
# RUST_LOG=

# ---------------------------------------------------------------------------
# Authentication — read by phototools-server (auth.rs)
# ---------------------------------------------------------------------------

# Firebase project ID. Token `iss` must equal
# https://securetoken.google.com/<project-id> and `aud` must equal it exactly.
# FIREBASE_PROJECT_ID=

# Comma-separated Firebase UIDs permitted to use the system.
# Firebase authenticates any Google account in existence; this list is the only
# thing restricting access to the library (spec §5.3). It is not optional.
# ALLOWED_UIDS=

# Break-glass token for local administrative access when Firebase is
# unreachable (spec §5.3). Leave unset in normal operation.
# ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Google Photos — not yet read; wired up in Phase 12
# ---------------------------------------------------------------------------

# OAuth 2.0 credentials for a **Web application** client (spec §6.2).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# The redirect this server is reachable at, registered on the OAuth client.
# Must match exactly, including scheme and port.
# Example: http://nas.local:3000/api/connectors/google/callback
# GOOGLE_OAUTH_REDIRECT_URI=

# Key used to encrypt the Google refresh token at rest (spec §6.2 step 4).
# Exactly 32 bytes, hex-encoded. Generate one with: openssl rand -hex 32
# Publishing refuses to store a token without it, rather than falling back to
# storing it in the clear.
# GOOGLE_REFRESH_TOKEN_ENCRYPTION_KEY=
