{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // `src/ui` holds Vue single-file components, which plain `tsc` cannot compile
  // and which import `@host/api` — a module only an application can supply.
  // They are consumed as source by each front end's Vite build and typechecked
  // there; `dist` stays the compiled client library it has always been.
  "exclude": ["src/ui"]
}
