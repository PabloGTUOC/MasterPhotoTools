{
  "name": "@phototools/rollchrome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build --force",
    "check:transport": "node scripts/check-transport.mjs",
    "check:edit": "node scripts/check-edit.mjs",
    "check:bulk-lut": "node scripts/check-bulk-lut.mjs",
    "check:develop": "node scripts/check-develop.mjs",
    "check:viewing": "node scripts/check-viewing.mjs",
    "check:colour": "node scripts/check-colour.mjs",
    "check:history": "node scripts/check-history.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:detail": "node scripts/check-detail.mjs"
  },
  "dependencies": {
    "@phototools/shared": "file:../shared",
    "@tauri-apps/api": "^2.1.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "playwright": "1.62.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
